<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://example.com/glasshome"
        version="1.0.0"
        viewmodes="maximized">
    <tizen:application id="GlassHome1.launcher" package="GlassHome1" required_version="6.0"/>
    <tizen:profile name="tv-samsung"/>

    <name>Home</name>
    <description>Minimal Liquid Glass launcher for Samsung Tizen TVs.</description>
    <icon src="icon.png"/>
    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>

    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>

    <!-- Network access for optional TMDB / OMDb / Trakt + poster images. -->
    <access origin="*" subdomains="true"/>

    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
</widget>
