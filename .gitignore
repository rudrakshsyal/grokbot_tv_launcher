# Build output and packages (contain your API keys)
dist/
*.wgt
*.tgz
*.zip
*.bak
*~

# Secrets, tokens, certificates, env files
.secrets/
relay/.secrets/
certs/
relay/certs/
.env
.env.*
*.env
!.env.example
!relay/.env.example
.env.sh
relay/.env.sh
*.key
*.pem
*.p12

# Relay runtime data: saved chats (data/chats), learned TV info (data/tv.json)
relay/data/

# Local speech-to-text install (tools/install-whisper.sh puts it in ~/.glasshome by default)
whisper.cpp/
*.bin

# Logs, metrics and eval reports (may contain your prompts)
logs/
relay/logs/
relay/evals/reports/
*.log

node_modules/
.DS_Store
preview*.png
mockups/**/*.png
