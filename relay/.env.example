# Copy to relay/.env (git-ignored, chmod 600) and fill in your own values. Never commit the real file.
# Load it before starting the relay:   cd relay && set -a && . ./.env && set +a && node server.js

# --- TV (give the TV a DHCP reservation in your router) ---
TV_IP=192.168.1.50
# Wake-on-LAN. TV Settings > Support > About This TV shows the MAC. Also turn on
# Settings > General > Network > Expert Settings > Power On with Mobile. Leave empty to let the relay learn it.
TV_MAC=aa:bb:cc:dd:ee:ff

# --- Brain (all free tiers; leave keys empty for the built-in parser only) ---
BRAIN_PRESET=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Titles, ratings ---
TMDB_API_KEY=
OMDB_API_KEY=

# --- Location for weather + "today" (example: San Jose, CA) ---
WEATHER_LAT=37.3382
WEATHER_LON=-121.8863
WEATHER_PLACE=San Jose
HOME_TZ=America/Los_Angeles

# --- Speech-to-text for hold-to-talk: auto (whisper.cpp if installed, else Gemini), whisper, gemini, off ---
STT=auto

# --- YouTube: dial (default; opens the YouTube app) or search (experimental key presses, unreliable) ---
YT_MODE=dial
